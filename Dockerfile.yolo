FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only PyTorch first (the default build is several GB bigger)
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements-yolo.txt .
RUN pip install --no-cache-dir -r requirements-yolo.txt

COPY src ./src
COPY api ./api
COPY yolo_models ./yolo_models

ENV PYTHONPATH=/app/src:/app

CMD ["uvicorn", "api.yolo_api:app", "--host", "0.0.0.0", "--port", "8080"]
