FROM python:3.12-trixie

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_FROZEN=1 \
    PYTHONPATH=/app/src:/app \
    PATH="/app/.venv/bin:$PATH"

# Dependencies first (cached layer): only the classifier group, exact versions from uv.lock
COPY pyproject.toml uv.lock ./
RUN uv sync --only-group classifier

COPY src ./src
COPY api ./api
COPY models/classifier.keras models/classifier.keras

CMD ["uvicorn", "api.fast:app", "--host", "0.0.0.0", "--port", "8080"]
